{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "policyName": "Deny-Databricks-NoPublicIp",
    "policyDisplayName": "Deny public IPs for Databricks cluster",
    "policyDescription": "Denies the deployment of workspaces that do not use the noPublicIp feature to host Databricks clusters without public IPs."
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[variables('policyName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "Indexed",
        "displayName": "[variables('policyDisplayName')]",
        "description": "[variables('policyDescription')]",
        "metadata": {
          "version": "1.0.0",
          "category": "Databricks",
          "source": "https://github.com/Azure/Enterprise-Scale/",
          "alzCloudEnvironments": [
            "AzureCloud"
          ]
        },
        "parameters": {
          "effect": {
            "type": "String",
            "defaultValue": "Deny",
            "allowedValues": [
              "Audit",
              "Disabled",
              "Deny"
            ],
            "metadata": {
              "displayName": "Effect",
              "description": "Enable or disable the execution of the policy"
            }
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Databricks/workspaces"
              },
              {
                "field": "Microsoft.Databricks/workspaces/parameters.enableNoPublicIp.value",
                "notEquals": true
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]"
          }
        }
      }
    }
  ]
}