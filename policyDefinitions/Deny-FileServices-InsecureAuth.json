{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "policyName": "Deny-FileServices-InsecureAuth",
    "policyDisplayName": "File Services with insecure authentication methods should be denied",
    "policyDescription": "This policy denies the use of insecure authentication methods (NTLMv2) when using File Services on a storage account."
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[variables('policyName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "All",
        "displayName": "[variables('policyDisplayName')]",
        "description": "[variables('policyDescription')]",
        "metadata": {
          "version": "1.0.0",
          "category": "Storage",
          "source": "https://github.com/Azure/Enterprise-Scale/",
          "alzCloudEnvironments": [
            "AzureCloud",
            "AzureChinaCloud",
            "AzureUSGovernment"
          ]
        },
        "parameters": {
          "effect": {
            "type": "String",
            "defaultValue": "Deny",
            "allowedValues": [
              "Audit",
              "Deny",
              "Disabled"
            ],
            "metadata": {
              "displayName": "Effect",
              "description": "The effect determines what happens when the policy rule is evaluated to match"
            }
          },
          "notAllowedAuthMethods": {
            "type": "String",
            "defaultValue": "NTLMv2",
            "allowedValues": [
              "NTLMv2",
              "Kerberos"
            ],
            "metadata": {
              "displayName": "Authentication methods supported by server",
              "description": "The list of authentication methods that are not allowed."
            }
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "Microsoft.Storage/storageAccounts/fileServices/protocolSettings.smb.authenticationMethods",
                "contains": "[[parameters('notAllowedAuthMethods')]"
              },
              {
                "field": "type",
                "equals": "Microsoft.Storage/storageAccounts/fileServices"
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]"
          }
        }
      }
    }
  ]
}