{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "policyName": "Deny-MachineLearning-Compute-SubnetId",
    "policyDisplayName": "Enforce subnet connectivity for Azure Machine Learning compute clusters and compute instances",
    "policyDescription": "Enforce subnet connectivity for Azure Machine Learning compute clusters and compute instances."
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[variables('policyName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "Indexed",
        "displayName": "[variables('policyDisplayName')]",
        "description": "[variables('policyDescription')]",
        "metadata": {
          "version": "1.0.0",
          "category": "Machine Learning",
          "source": "https://github.com/Azure/Enterprise-Scale/",
          "alzCloudEnvironments": [
            "AzureCloud"
          ]
        },
        "parameters": {
          "effect": {
            "type": "String",
            "metadata": {
              "displayName": "Effect",
              "description": "Enable or disable the execution of the policy"
            },
            "allowedValues": [
              "Audit",
              "Disabled",
              "Deny"
            ],
            "defaultValue": "Deny"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.MachineLearningServices/workspaces/computes"
              },
              {
                "field": "Microsoft.MachineLearningServices/workspaces/computes/computeType",
                "in": [
                  "AmlCompute",
                  "ComputeInstance"
                ]
              },
              {
                "anyOf": [
                  {
                    "field": "Microsoft.MachineLearningServices/workspaces/computes/subnet.id",
                    "exists": false
                  },
                  {
                    "value": "[[empty(field('Microsoft.MachineLearningServices/workspaces/computes/subnet.id'))]",
                    "equals": true
                  }
                ]
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]"
          }
        }
      }
    }
  ]
}