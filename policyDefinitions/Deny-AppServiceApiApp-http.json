{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "policyName": "Deny-AppServiceApiApp-http",
    "policyDisplayName": "API App should only be accessible over HTTPS",
    "policyDescription": "Use of HTTPS ensures server/service authentication and protects data in transit from network layer eavesdropping attacks."
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[variables('policyName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "Indexed",
        "displayName": "[variables('policyDisplayName')]",
        "description": "[variables('policyDescription')]",
        "metadata": {
          "version": "1.0.0",
          "category": "App Service",
          "source": "https://github.com/Azure/Enterprise-Scale/",
          "alzCloudEnvironments": [
            "AzureCloud",
            "AzureChinaCloud",
            "AzureUSGovernment"
          ]
        },
        "parameters": {
          "effect": {
            "type": "String",
            "metadata": {
              "displayName": "Effect",
              "description": "Enable or disable the execution of the policy"
            },
            "allowedValues": [
              "Audit",
              "Disabled",
              "Deny"
            ],
            "defaultValue": "Deny"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Web/sites"
              },
              {
                "field": "kind",
                "like": "*api"
              },
              {
                "field": "Microsoft.Web/sites/httpsOnly",
                "equals": "false"
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]"
          }
        }
      }
    }
  ]
}
