{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "variables": {
    "policyName": "Audit-MachineLearning-PrivateEndpointId",
    "policyDisplayName": "Control private endpoint connections to Azure Machine Learning",
    "policyDescription": "Audit private endpoints that are created in other subscriptions and/or tenants for Azure Machine Learning."
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[variables('policyName')]",
      "properties": {
        "policyType": "Custom",
        "mode": "Indexed",
        "displayName": "[variables('policyDisplayName')]",
        "description": "[variables('policyDescription')]",
        "metadata": {
          "version": "1.0.0",
          "category": "Machine Learning",
          "source": "https://github.com/Azure/Enterprise-Scale/",
          "alzCloudEnvironments": [
            "AzureCloud"
          ]
        },
        "parameters": {
          "effect": {
            "type": "String",
            "metadata": {
              "displayName": "Effect",
              "description": "Enable or disable the execution of the policy"
            },
            "allowedValues": [
              "Audit",
              "Deny",
              "Disabled"
            ],
            "defaultValue": "Audit"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.MachineLearningServices/workspaces/privateEndpointConnections"
              },
              {
                "field": "Microsoft.MachineLearningServices/workspaces/privateEndpointConnections/privateLinkServiceConnectionState.status",
                "equals": "Approved"
              },
              {
                "anyOf": [
                  {
                    "field": "Microsoft.MachineLearningServices/workspaces/privateEndpointConnections/privateEndpoint.id",
                    "exists": false
                  },
                  {
                    "value": "[[split(concat(field('Microsoft.MachineLearningServices/workspaces/privateEndpointConnections/privateEndpoint.id'), '//'), '/')[2]]",
                    "notEquals": "[[subscription().subscriptionId]"
                  }
                ]
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]"
          }
        }
      }
    }
  ]
}